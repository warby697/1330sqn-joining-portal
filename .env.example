GOCARDLESS_ACCESS_TOKEN=
# Optional. Leave unset for live. For local sandbox testing set to
# https://api-sandbox.gocardless.com and use a sandbox access token above.
GOCARDLESS_API=
RESEND_API_KEY=
RESEND_FROM=
# Point at a SEPARATE test Firebase project for local testing so writes do
# not hit the live sqn-ops data.
FIREBASE_ADMIN_PROJECT_ID=sqn-ops
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
STAFF_PIN=1918
